{
  "name": "@lampstand/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Lampstand \u2014 church projection & live production",
  "main": "./out/main/index.js",
  "author": "Lampstand",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "dist:mac": "node scripts/prepareFfmpeg.mjs mac && electron-vite build && electron-builder --mac",
    "dist:mac:local": "node scripts/prepareFfmpeg.mjs mac && electron-vite build && electron-builder --mac -c.mac.notarize=false -c.mac.identity=-",
    "dist:mac:local:intel": "node scripts/prepareFfmpeg.mjs mac x64 && electron-vite build && electron-builder --mac --x64 -c.mac.notarize=false -c.mac.identity=-",
    "dist:win": "node scripts/prepareFfmpeg.mjs win x64 && electron-vite build && electron-builder --win --x64",
    "e2e": "electron-vite build && playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.14.0",
    "@fontsource/anton": "5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/dm-serif-display": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@fontsource/oswald": "5.3.0",
    "@fontsource/outfit": "5.3.0",
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "@fontsource/poppins": "5.3.0",
    "@fontsource/raleway": "5.3.0",
    "@mediapipe/tasks-vision": "1.2.2",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "chokidar": "6.0.0",
    "fflate": "0.8.3",
    "koffi": "^3.3.8",
    "minisearch": "7.2.0",
    "pdfjs-dist": "4.10.38",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@fontsource/bebas-neue": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/lora": "5.3.0",
    "@fontsource/montserrat": "5.3.0",
    "@fontsource/playfair-display": "5.3.0",
    "@fontsource/source-serif-4": "5.3.1",
    "@huggingface/transformers": "4.3.2",
    "@lampstand/core": "workspace:*",
    "@lampstand/detection": "workspace:*",
    "@lampstand/ipc-contract": "workspace:*",
    "@lampstand/lyrics": "workspace:*",
    "@lampstand/planner": "workspace:*",
    "@lampstand/renderer": "workspace:*",
    "@lampstand/scripture": "workspace:*",
    "@lampstand/ui": "workspace:*",
    "@playwright/test": "1.65.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-select": "2.4.1",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/react-virtual": "3.14.26",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.3.1",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "ffmpeg-static": "5.2.0",
    "i18next": "27.1.1",
    "lucide-react": "1.72.0",
    "onnxruntime-web": "1.31.0-dev.20260914-8d85527a0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "18.0.1",
    "tailwindcss": "4.3.5",
    "vite": "8.3.8",
    "zustand": "5.1.0"
  }
}
